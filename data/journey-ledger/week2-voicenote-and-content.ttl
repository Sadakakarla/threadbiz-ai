    tb:title                "Owner voice note — after Week 1 deliveries" ;
    tb:description          "Owner's voice note after finishing Week 1 pickups: mentions a returning customer (Maria) requesting roast chicken, a new customer (Dave, referred by Maria) requesting something heartier, the soup selling out faster than expected, and a reminder to keep leaning into story-driven posts." ;
    tb:dateOccurred         "2026-09-23"^^xsd:date ;
    tb:dateRecorded         "2026-09-23"^^xsd:date ;
    tb:emotionalTone        "upbeat, encouraged" ;
    tb:canBeUsedPublicly    false ;
