@prefix threadbiz: <https://threadbiz.example/#> .
@prefix schema: <https://schema.org/> .

# ------------------------------------------------------------
# MAIN BUSINESS MEMORY RECORD
# ------------------------------------------------------------
threadbiz:business-memory a threadbiz:BusinessMemoryAsset ;

  # --- IDENTITY (unchanged from v1) ---
  threadbiz:businessId "neighborhood-table-001" ;
  threadbiz:businessName "The Neighborhood Table" ;
  threadbiz:industry "home-based-weekly-meal-drop" ;
  threadbiz:location "home-based, no fixed city" ;
  threadbiz:stage "early" ;

  # --- VOICE & COMMUNICATION (unchanged from v1) ---
  threadbiz:preferredTone "warm, personal, rooted in family and heritage" ;
  threadbiz:avoidPhrases "gourmet, chef-inspired, limited time only (overused)" ;

  # --- GOALS (unchanged from v1) ---
  threadbiz:statedGoals "build a loyal weekly customer base through consistent, high-quality limited pre-order meals" ;

  # --- SEASONAL RHYTHM (unchanged from v1) ---
  threadbiz:seasonalContext "Weekly cadence year-round; menu shifts with seasonal ingredients; extra demand around major holidays" ;

  # --- CONFIRMED FACTS (unchanged from v1) ---
  threadbiz:confirmedFact [
    threadbiz:statement "Started from family heritage recipes, began with a small weekly pre-order drop for neighbors" ;
    threadbiz:source "owner-voice-note-1" ;
    threadbiz:confirmedAt "2026-09-21"
  ] ;

  # --- DISTILLED MEMORY (unchanged from v1) ---
  threadbiz:successfulPattern "Customers respond well when the story behind a dish (whose recipe it is, why it matters) is included, not just the dish itself" ;
  threadbiz:knownFailure "Generic weekly announcements without a story felt forgettable and got less engagement" ;
  threadbiz:nextContentStrategy "Always tie the week's menu to a short story or seasonal ingredient note; keep pickup/capacity details clear and consistent" ;

  # --- VERSION TRACKING (updated) ---
  threadbiz:version "2" ;
  threadbiz:updatedAt "2026-09-23" ;
  threadbiz:previousVersion "1" ;
  threadbiz:versionChangeNote "Added keyPerson Maria T. (returning customer, ordered Week 1's soup — first customer to appear in the memory record) and Dave (new customer, first order, referred by Maria via word-of-mouth). v1 only recorded the Owner; this is the first time the memory graph reflects real customer relationships. Learned via owner voice note (Journey Ledger entry-003)." .

# ------------------------------------------------------------
# KEY PEOPLE
# ------------------------------------------------------------
threadbiz:key-person-owner a threadbiz:KeyPerson ;
  threadbiz:name "Owner" ;
  threadbiz:role "founder and cook" ;
  threadbiz:note "cooks all meals personally, manages weekly pre-orders and pickups" ;
  threadbiz:belongsTo threadbiz:business-memory .

threadbiz:key-person-maria a threadbiz:KeyPerson ;
  threadbiz:name "Maria T." ;
  threadbiz:role "returning customer" ;
  threadbiz:note "Ordered Week 1's soup, requested roast chicken for Week 2. Referred Dave (word-of-mouth)." ;
  threadbiz:belongsTo threadbiz:business-memory .

threadbiz:key-person-dave a threadbiz:KeyPerson ;
  threadbiz:name "Dave" ;
  threadbiz:role "returning customer (new, referred by Maria)" ;
  threadbiz:note "Came with his daughter, first time ordering — mentioned wanting something heartier as the weather turns. Requested via Maria's referral." ;
  threadbiz:belongsTo threadbiz:business-memory .
